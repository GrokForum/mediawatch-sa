{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediawatch.sa.local/schema/v0.4-draft",
  "title": "MediaWatch SA data schema v0.4-draft (primary + secondary lean)",
  "description": "Primary: FOR/AGAINST named actors (findings, scores). Secondary: left/right lean_scores derived from findings × actor_axis_map — kept separate. Draft only.",
  "type": "object",
  "properties": {
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "url",
          "language"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "owner_group": {
            "type": "string"
          },
          "owner_fact_label": {
            "$ref": "#/$defs/fact_label"
          },
          "language": {
            "type": "string",
            "enum": [
              "EN",
              "AF",
              "multi"
            ]
          },
          "editor_in_chief": {
            "type": [
              "string",
              "null"
            ]
          },
          "editor_source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "editor_checked_on": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "archive_only",
              "closed"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "full_name",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "publication_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "x_handle": {
            "type": [
              "string",
              "null"
            ]
          },
          "x_user_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "x_handle_source_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "x_handle_checked_on": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "articles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "publication_id",
          "url",
          "published_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "publication_id": {
            "type": "string"
          },
          "author_person_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "headline": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "published_at": {
            "type": "string"
          },
          "byline_raw": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "fetched_at": {
            "type": "string"
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "seed_lead"
            ]
          },
          "published_at_precision": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "date",
              "datetime",
              null
            ],
            "description": "Precision of published_at. 'date' = calendar date only (no reliable time)."
          }
        }
      }
    },
    "public_posts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "person_id",
          "platform",
          "url",
          "text",
          "posted_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "person_id": {
            "type": "string"
          },
          "publication_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "platform": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "text": {
            "type": "string"
          },
          "posted_at": {
            "type": "string"
          },
          "metrics_json": {
            "type": "object"
          },
          "repost_of_post_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "quoted_post_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "fetched_at": {
            "type": "string"
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "seed_lead"
            ]
          },
          "credit": {
            "type": "string"
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "publication_id",
          "actor",
          "direction",
          "driver",
          "quote",
          "url",
          "published_at",
          "fact_label",
          "steelman_for",
          "steelman_against",
          "weight",
          "signed_score"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "article_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "public_post_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "publication_id": {
            "type": "string"
          },
          "person_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "actor": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "FOR",
              "AGAINST"
            ]
          },
          "driver": {
            "type": "string",
            "enum": [
              "loaded_label",
              "one_sided_sourcing",
              "missing_right_of_reply",
              "omission",
              "framing",
              "headline_body_gap",
              "factual_error",
              "correction"
            ]
          },
          "quote": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "published_at": {
            "type": "string"
          },
          "fact_label": {
            "$ref": "#/$defs/fact_label"
          },
          "steelman_for": {
            "type": "string"
          },
          "steelman_against": {
            "type": "string"
          },
          "evidence_notes": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "signed_score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -2,
            "maximum": 2,
            "description": "Signed primary score (−2…+2). Null when accountability_exempt (finding recorded but excluded from numeric primary score)."
          },
          "methodology_version": {
            "type": "string"
          },
          "coder": {
            "type": "string"
          },
          "credit": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional credit (e.g. AGOA SA casebook). Null when none."
          },
          "created_at": {
            "type": "string"
          },
          "target_inferred": {
            "type": "boolean",
            "description": "True when AfriMAGA/loaded label mapped to org via explicit context"
          },
          "target_context_quote": {
            "type": [
              "string",
              "null"
            ],
            "description": "Context line proving who AfriMAGA refers to"
          },
          "sample_frame": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "keyword",
              "neutral_random",
              "counter_pull",
              "external_seed",
              "purposive",
              null
            ],
            "description": "How the item entered the sample. purposive = judgement / byline corpus with no pre-registered random rule."
          },
          "accountability_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "bias",
              "borderline",
              "accountability_exempt",
              "accountability",
              "neutral_method",
              "control",
              null
            ],
            "description": "§8b/§8c coding. accountability_exempt ⇒ signed_score may be null. control = balance/contrast finding retained in the sample (see METHODOLOGY)."
          },
          "published_at_precision": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "date",
              "datetime",
              null
            ],
            "description": "Precision of published_at. 'date' = calendar date only (no reliable time)."
          }
        }
      }
    },
    "actor_axis_map": {
      "type": "array",
      "description": "Published actor→axis placements (also data/actor_axis_map.csv)",
      "items": {
        "$ref": "#/$defs/actor_axis_row"
      }
    },
    "lean_scores": {
      "type": "array",
      "description": "SECONDARY meter only. Never mix with primary scores. Derived: contribution = signed_score * actor_axis / 2; mean; clamp −2..+2. See docs/LEFT_RIGHT_METHOD.md.",
      "items": {
        "$ref": "#/$defs/lean_score_entity"
      }
    }
  },
  "$defs": {
    "fact_label": {
      "type": "string",
      "enum": [
        "Proven",
        "Established",
        "Alleged",
        "Disputed",
        "Not established"
      ]
    },
    "actor_axis_row": {
      "type": "object",
      "required": [
        "actor",
        "placement_contested",
        "rationale",
        "sources"
      ],
      "properties": {
        "actor": {
          "type": "string"
        },
        "economic_axis": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -2,
          "maximum": 2,
          "description": "-2 state/redistribution … +2 market; null = unmapped"
        },
        "social_axis": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -2,
          "maximum": 2
        },
        "placement_contested": {
          "enum": [
            "no",
            "partial",
            "yes",
            "n/a"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "sources": {
          "type": "string"
        }
      }
    },
    "lean_score_entity": {
      "type": "object",
      "required": [
        "entity_type",
        "entity_id",
        "pooled",
        "secondary_view_banner"
      ],
      "properties": {
        "entity_type": {
          "enum": [
            "publication",
            "person"
          ]
        },
        "entity_id": {
          "type": "string"
        },
        "display_label": {
          "type": "string"
        },
        "secondary_view_banner": {
          "type": "string",
          "const": "Secondary view: left/right lean (reader convenience). The primary measure is for/against named actors."
        },
        "pooled": {
          "$ref": "#/$defs/lean_rollup"
        },
        "by_sample_frame": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/lean_rollup"
          }
        },
        "direct_lean_label_signals": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "direct_lean_label_signals_folded_into_score": {
          "type": "boolean",
          "const": false
        }
      }
    },
    "lean_rollup": {
      "type": "object",
      "required": [
        "n_included",
        "flag"
      ],
      "properties": {
        "n_included": {
          "type": "integer",
          "minimum": 0
        },
        "n_skipped": {
          "type": "integer",
          "minimum": 0
        },
        "flag": {
          "enum": [
            "findings_only",
            "provisional",
            "full"
          ]
        },
        "lean_economic": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -2,
          "maximum": 2,
          "description": "−2…+2; MUST be null when flag is findings_only."
        },
        "lean_social": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -2,
          "maximum": 2,
          "description": "−2…+2; MUST be null when flag is findings_only."
        },
        "lean_composite": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -2,
          "maximum": 2,
          "description": "−2…+2; MUST be null when flag is findings_only."
        },
        "share_contested_placements": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
